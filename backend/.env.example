# Copie para .env e preencha as credenciais do seu MySQL.
TRIAQUI_DB_HOST=localhost
TRIAQUI_DB_PORT=3306
TRIAQUI_DB_USER=root
TRIAQUI_DB_PASSWORD=
TRIAQUI_DB_NAME=triaqui_db

# Defina um segredo aleatorio privado para manter as sessoes apos reiniciar.
TRIAQUI_JWT_SECRET=

# Python 3.10+; deixe vazio para deteccao automatica.
TRIAQUI_PYTHON=
TRIAQUI_AI_ENABLED=true
TRIAQUI_AI_URL=http://127.0.0.1:8001/predict
